# 이 파일을 복사해서 .env 로 만들고 값을 채워 주세요. (.env 는 git에 올라가지 않습니다)
# cp .env.example .env

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=preen
DB_USERNAME=root
DB_PASSWORD=

# ===== 프론트엔드 주소 (CORS) =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== 회원가입 이메일 인증 (값은 회원가입 담당 팀원에게 받기) =====
MAIL_USERNAME=
MAIL_PASSWORD=
# 32자 이상 임의 문자열
AUTH_HASH_SECRET=
# 16진수 64자리 (예: openssl rand -hex 32)
EMAIL_ENCRYPTION_KEY=
